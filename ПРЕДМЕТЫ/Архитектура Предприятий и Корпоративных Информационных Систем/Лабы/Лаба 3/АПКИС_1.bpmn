<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Orchestration"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_1" value="Закрытие операции в учёте" />
  </bpmn:category>

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Buh" name="Бухгалтерия" processRef="Process_Accounting" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Accounting" name="Обработка первичного документа" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Buh" name="Бухгалтер">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Post</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Glav" name="Главный бухгалтер">
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Получен первичный документ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Check" name="Проверить первичный документ">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_1">
        <bpmn:sourceRef>DataObjectRef_Doc</bpmn:sourceRef>
        <bpmn:targetRef>Task_Check</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_1" name="Документ корректен?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Return" name="Вернуть документ на исправление">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Reject" name="Документ отклонён">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_Post" name="Внести проводки в учётную систему">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:sourceRef>Task_Post</bpmn:sourceRef>
        <bpmn:targetRef>DataStore_Ledger</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:task id="Task_Approve" name="Утвердить проводки и сформировать отчёт">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Done" name="Операция отражена в учёте">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataObjectReference id="DataObjectRef_Doc" name="Первичный документ" dataObjectRef="DataObject_Doc" />
    <bpmn:dataObject id="DataObject_Doc" />
    <bpmn:dataStoreReference id="DataStore_Ledger" name="Регистры бухгалтерского учёта" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Check" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_3" name="Нет" sourceRef="Gateway_1" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="Flow_4" name="Да" sourceRef="Gateway_1" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Return" targetRef="EndEvent_Reject" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Post" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Approve" targetRef="EndEvent_Done" />

    <bpmn:textAnnotation id="TextAnnotation_1">
      <bpmn:text>Отчёт формируется по данным регистров учёта</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Task_Approve" targetRef="TextAnnotation_1" associationDirection="None" />
    <bpmn:group id="Group_1" categoryValueRef="CategoryValue_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Buh_di" bpmnElement="Participant_Buh" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="800" height="460" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Buh_di" bpmnElement="Lane_Buh" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="770" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Glav_di" bpmnElement="Lane_Glav" isHorizontal="true">
        <dc:Bounds x="190" y="380" width="770" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="250" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="223" y="272" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check">
        <dc:Bounds x="330" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <dc:Bounds x="480" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="455" y="285" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Return_di" bpmnElement="Task_Return">
        <dc:Bounds x="580" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Reject_di" bpmnElement="EndEvent_Reject">
        <dc:Bounds x="740" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="713" y="162" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Post_di" bpmnElement="Task_Post">
        <dc:Bounds x="580" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve">
        <dc:Bounds x="580" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Done_di" bpmnElement="EndEvent_Done">
        <dc:Bounds x="740" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="713" y="482" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_Doc_di" bpmnElement="DataObjectRef_Doc">
        <dc:Bounds x="350" y="110" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="395" y="120" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_Ledger_di" bpmnElement="DataStore_Ledger">
        <dc:Bounds x="790" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="755" y="285" width="120" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_1_di" bpmnElement="TextAnnotation_1">
        <dc:Bounds x="370" y="430" width="150" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Group_1_di" bpmnElement="Group_1">
        <dc:Bounds x="560" y="400" width="250" height="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="595" y="403" width="180" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="286" y="250" />
        <di:waypoint x="330" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="430" y="250" />
        <di:waypoint x="480" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="505" y="225" />
        <di:waypoint x="505" y="140" />
        <di:waypoint x="580" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="512" y="180" width="26" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="530" y="250" />
        <di:waypoint x="580" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="543" y="230" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="680" y="140" />
        <di:waypoint x="740" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="630" y="290" />
        <di:waypoint x="630" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="680" y="460" />
        <di:waypoint x="740" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataInputAssociation_1_di" bpmnElement="DataInputAssociation_1">
        <di:waypoint x="368" y="160" />
        <di:waypoint x="368" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutputAssociation_1_di" bpmnElement="DataOutputAssociation_1">
        <di:waypoint x="680" y="250" />
        <di:waypoint x="790" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_1_di" bpmnElement="Association_1">
        <di:waypoint x="580" y="460" />
        <di:waypoint x="520" y="460" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>