<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Collaboration"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:message id="Message_Invoice" name="Счёт на оплату" />
  <bpmn:message id="Message_Payment" name="Платёжное поручение" />

  <bpmn:collaboration id="Collaboration_2">
    <bpmn:participant id="Participant_Supplier" name="Поставщик" />
    <bpmn:participant id="Participant_Buh" name="Бухгалтерия" processRef="Process_Payment" />
    <bpmn:messageFlow id="MessageFlow_Invoice" name="Счёт на оплату" sourceRef="Participant_Supplier" targetRef="StartEvent_Invoice" messageRef="Message_Invoice" />
    <bpmn:messageFlow id="MessageFlow_Payment" name="Платёжное поручение" sourceRef="SendTask_Payment" targetRef="Participant_Supplier" messageRef="Message_Payment" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Payment" name="Обработка счёта и оплата" isExecutable="false">
    <bpmn:startEvent id="StartEvent_Invoice" name="Счёт получен">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_Invoice" />
    </bpmn:startEvent>

    <bpmn:task id="Task_Check" name="Проверить и провести счёт">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1">
        <bpmn:sourceRef>Task_Check</bpmn:sourceRef>
        <bpmn:targetRef>DataStore_Ledger</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>

    <bpmn:sendTask id="SendTask_Payment" name="Направить платёжное поручение" messageRef="Message_Payment">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="EndEvent_Paid" name="Счёт оплачен">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:dataStoreReference id="DataStore_Ledger" name="Регистры учёта" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Invoice" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Check" targetRef="SendTask_Payment" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SendTask_Payment" targetRef="EndEvent_Paid" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_2">
    <bpmndi:BPMNPlane id="BPMNPlane_2" bpmnElement="Collaboration_2">
      <bpmndi:BPMNShape id="Participant_Supplier_di" bpmnElement="Participant_Supplier" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="760" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Buh_di" bpmnElement="Participant_Buh" isHorizontal="true">
        <dc:Bounds x="160" y="280" width="760" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Invoice_di" bpmnElement="StartEvent_Invoice">
        <dc:Bounds x="230" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="203" y="412" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check">
        <dc:Bounds x="320" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendTask_Payment_di" bpmnElement="SendTask_Payment">
        <dc:Bounds x="490" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Paid_di" bpmnElement="EndEvent_Paid">
        <dc:Bounds x="660" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="633" y="412" width="90" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_Ledger_di" bpmnElement="DataStore_Ledger">
        <dc:Bounds x="345" y="470" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="320" y="525" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="266" y="390" />
        <di:waypoint x="320" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="420" y="390" />
        <di:waypoint x="490" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="390" />
        <di:waypoint x="660" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOutputAssociation_1_di" bpmnElement="DataOutputAssociation_1">
        <di:waypoint x="370" y="430" />
        <di:waypoint x="370" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_Invoice_di" bpmnElement="MessageFlow_Invoice">
        <di:waypoint x="248" y="140" />
        <di:waypoint x="248" y="372" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="256" y="230" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_Payment_di" bpmnElement="MessageFlow_Payment">
        <di:waypoint x="540" y="350" />
        <di:waypoint x="540" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="230" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>