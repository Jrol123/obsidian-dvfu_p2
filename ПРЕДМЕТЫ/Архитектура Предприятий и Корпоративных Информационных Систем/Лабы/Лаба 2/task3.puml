@startuml Диаграмма классов
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

class "Документ" as Doc {
    +номер: String
    +дата: Date
    +провести()
}

class "Первичный документ" as PDoc {
    +контрагент: String
    +сумма: Money
}

class "Проводка" as Entry {
    +дата: Date
    +сумма: Money
}

class "Счёт учёта" as Acc {
    +номер: String
    +наименование: String
}

Doc <|-- PDoc
PDoc "1" *-- "1..*" Entry
Entry --> "2" Acc : дебет/кредит
@enduml