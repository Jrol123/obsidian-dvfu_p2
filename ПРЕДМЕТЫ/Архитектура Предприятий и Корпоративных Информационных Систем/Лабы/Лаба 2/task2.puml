@startuml Диаграмма вариантов использования (прецедентов)
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
left to right direction

Person(B, "Бухгалтер")
Person(GB, "Главный\nбухгалтер")

rectangle "Система бухгалтерского учёта" {
  usecase "Ввод первичного документа" as UC1
  usecase "Формирование проводки" as UC2
  usecase "Закрытие периода" as UC3
  usecase "Формирование отчётности" as UC4
}

B --> UC1
B --> UC2
GB --> UC3
GB --> UC4
@enduml