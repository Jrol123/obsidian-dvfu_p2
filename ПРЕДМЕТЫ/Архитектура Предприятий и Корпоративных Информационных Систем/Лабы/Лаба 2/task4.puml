@startuml АДД
skinparam shadowing false

|#AliceBlue|Бухгалтер|
start
:Получить первичный документ\n(счёт-фактура, накладная, п/п);
repeat
  :Проверить и заполнить реквизиты;
  |#LightYellow|ИС «Бухгалтерия»|
  :Выполнить форматно-логический контроль;
  |Бухгалтер|
repeat while (Реквизиты корректны?) is (нет) not (да)

|ИС «Бухгалтерия»|
:Зарегистрировать документ в журнале;
:Определить корреспонденцию счетов\nпо плану счетов;
:Сформировать проводку (Дт / Кт);
while (Сумма по дебету = сумме по кредиту?) is (нет)
  |Бухгалтер|
  :Скорректировать счета и суммы;
  |ИС «Бухгалтерия»|
  :Пересчитать проводку;
endwhile (да)
:Записать проводку в журнал проводок;

|#LightGreen|Главный бухгалтер|
:Инициировать закрытие отчётного периода;
repeat
  |ИС «Бухгалтерия»|
  :Рассчитать обороты и сальдо по счетам;
  :Сформировать оборотно-сальдовую ведомость;
  |Главный бухгалтер|
  :Проверить контрольные соотношения;
  if (Соотношения выполнены?) then (да)
    |ИС «Бухгалтерия»|
    :Сформировать баланс и отчёт\nо финансовых результатах;
  else (нет)
    |Бухгалтер|
    :Сторнировать ошибочные проводки;
    :Внести корректирующие проводки;
  endif
repeat while (Отчётность сформирована?) is (нет) not (да)

|Главный бухгалтер|
:Утвердить бухгалтерскую отчётность;
:Подписать отчётность ЭЦП;
|ИС «Бухгалтерия»|
:Закрыть период и заблокировать проводки;
repeat
  :Выгрузить отчётность в формате ФНС;
  :Отправить отчётность по ТКС;
  |#Pink|ФНС|
  :Проверить формат и контрольные соотношения;
  if (Отчётность принята?) then (да)
    :Сформировать квитанцию о приёме;
  else (нет)
    :Сформировать протокол ошибок;
    |Бухгалтер|
    :Устранить замечания;
    |Главный бухгалтер|
    :Повторно утвердить отчётность;
  endif
repeat while (Квитанция о приёме получена?) is (нет) not (да)

|ИС «Бухгалтерия»|
:Сохранить отчётность и квитанцию\nв электронном архиве;
|Главный бухгалтер|
:Завершить сдачу отчётности за период;
stop
@enduml