@startuml Диаграмма вариантов использования (прецедентов)
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
left to right direction

Person(B, "Бухгалтер")
Person(GB, "Главный\nбухгалтер")

rectangle "Система бухгалтерского учёта" {
  usecase "Ввод первичного документа" as B1
  usecase "Формирование проводки" as B2
  usecase "Закрытие периода" as G1
  usecase "Формирование отчётности" as G2
}

B --> B1
B --> B2
GB --> G1
GB --> G2
@enduml

@startuml Диаграмма классов
class "Документ" as Doc {
    +номер: String
    +дата: Date
    +провести()
}

class "Первичный документ" as PDoc {
    +контрагент: String
    +сумма: Money
}

class "Проводка" as Entry {
    +дата: Date
    +сумма: Money
}

class "Счёт учёта" as Acc {
    +номер: String
    +наименование: String
}

Doc <|-- PDoc
PDoc "1" *-- "1..*" Entry
Entry --> "2" Acc : дебет/кредит
@enduml

@startuml Диаграмма деятельности
start
:Получение первичного документа;
:Проверка реквизитов документа;
if (Реквизиты корректны?) then (да)
    :Регистрация документа;
    :Формирование проводки;
    if (Дебет = Кредит?) then (нет)
        :Корректировка проводки;
    else (да)
    endif
    :Запись проводки в регистры учёта;
else (нет)
    :Возврат документа на доработку;
endif
stop
@enduml