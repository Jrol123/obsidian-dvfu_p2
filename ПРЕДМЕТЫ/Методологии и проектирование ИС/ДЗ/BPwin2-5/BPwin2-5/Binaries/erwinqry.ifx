[Diagram||BPER Syncer Get Attribute Definitions|Retrieves attribute definitions|System Queries]
SELECT
    obj.Object_Id , 
    Value_Seqnce_Numer "-" , 
    String_Value "+String_Value"
  FROM erw_Object obj , erw_Column col, erw_Obct_Phal_Prty def 
  WHERE obj.Class_Id = 7
    and obj.Container_Id = %Diagram_Id
	and col.Column_Id = obj.Twin_Id
	and def.Object_Id = col.Domain_Id 
	and def.Phycal_Property_Id = %AttDefId
order by 1,2

[Diagram||BPER Syncer Get Parent Attribute Definitions|Retrieves attribute definitions|System Queries]
SELECT
    obj.Object_Id , 
    Value_Seqnce_Numer "-" , 
    String_Value "+String_Value"
  FROM erw_Object obj, erw_Column col, erw_Domain dom, erw_Obct_Phal_Prty pdef 
  WHERE obj.Class_Id = 7
    and obj.Container_Id = %Diagram_Id
	and col.Column_Id = obj.Twin_Id
	and dom.Domain_Id = col.Domain_Id
	and pdef.Object_Id = dom.Parent_Domain_Id 
	and pdef.Phycal_Property_Id = %AttDefId
order by 1,2
