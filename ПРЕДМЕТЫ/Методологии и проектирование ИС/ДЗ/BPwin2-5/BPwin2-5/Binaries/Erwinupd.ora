/*                                                                           */
/*   Purpose: PL/SQL to update a ModelMart for compatibility           */
/*            with the latest client software                                */
/*                                                                           */
/* * * * * * * * * * * Copyright (c) Logic Works 1995  * * * * * * * * * * * */                                         

/* ERwin Version : $Header: /erwincsx/csxsql/erwinupd.ora 146   1/23/98 12:17p Dmccann $ */
/* $Revision: 146 $ */
/* $Date: 1/23/98 12:17p $ */

BEGIN
      /*** place current version # in master table ***/
      UPDATE erw_Master
         set Version = %4,
             Creation_Date = SYSDATE
         where Repository_Name = '%2';
      
END;
run
