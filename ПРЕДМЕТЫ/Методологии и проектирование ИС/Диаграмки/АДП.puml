@startuml Архитектурная диаграмма потоков
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

left to right direction

' Пользователи
Person(sci, "Учёный секретарь", "Модерирует данные, формирует сводные отчёты")
Person(regular, "Научный сотрудник", "Вносит свои публикации, получает персональные отчёты")
Person(dep, "Руководитель подразделения", "Просматривает публикации подразделения, управляет грантами")
Person(admin, "Администратор", "Управляет учётными записями и шаблонами отчётов")

' Внешние системы

ContainerDb(fs, "Файловое хранилище", "docx", "Файлы с шаблонами отчётов")

' Граница основной системы
System_Boundary(system, "Система автоматизации учёта") {
    Container(web_app, "Веб-приложение", "Django, jQuery, AJAX", "Обрабатывает запросы пользователей, реализует бизнес-логику, формирует отчёты")
    Container(cron, "Система расписания", "cron", "По расписанию вызывает функции веб-приложения")
    Container(ai_service, "Сервис ИИ-помощника", "Ollama + LangChain", "Анализирует библиографические описания, предоставляет сводку по запросу;\nВыдаёт статистику по пользователю или подразделению")
}
ContainerDb(db, "База данных", "PostgreSQL", "Хранит публикации, сведения о сотрудниках, подразделения, гранты, расчёты КБПР")

' Взаимодействия
' Пользователи -> Веб-приложение
Rel(regular, web_app, "Ввод/просмотр своих публикаций, запрос персонального отчёта, чат с ИИ-помощником")
Rel(dep, web_app, "Просмотр публикаций подразделения, управление грантами, отчёт по подразделению")
Rel(sci, web_app, "Модерация публикаций и отчётов, просмотр всех данных, формирование сводных отчётов")
Rel(admin, web_app, "Управление пользователями, загрузка/правка шаблонов, просмотр журналов")

' Веб-приложение -> База данных
Rel(web_app, db, "Сохранение и чтение данных о публикациях, сотрудниках, грантах, КБПР")

' Администратор -> Файловое хранилище (загрузка шаблонов)
' Rel_Neighbor(admin, fs, "Загрузка и замена шаблонов отчётов")
Rel(sci, fs, "Загрузка и замена шаблонов отчётов")

' Веб-приложение -> Файловое хранилище
Rel(web_app, fs, "Чтение шаблонов .docx для генерации отчётов", "Доступ к файловой системе")

' Веб-приложение -> Сервис ИИ
Rel(web_app, ai_service, "Отправка библиографического описания, запроса сводки или текстового запроса")
Rel(ai_service, web_app, "Возврат структурированных полей, текста сводки или текстового ответа (статистика)")

Rel(cron, web_app, "Получение списка журналов из 'Белого списка' раз в квартал")

' Сервис ИИ может только вызываться, собственных хранилищ не показано

@enduml