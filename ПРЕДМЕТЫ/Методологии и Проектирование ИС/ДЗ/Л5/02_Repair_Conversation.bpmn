<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RepairConversation" targetNamespace="urn:tech-repair:bpmn">
  <bpmn:message id="Message_Request" name="Заявка на ремонт" />
  <bpmn:message id="Message_Estimate" name="Диагноз, стоимость и срок" />
  <bpmn:message id="Message_Decision" name="Согласие или отказ" />
  <bpmn:message id="Message_Ready" name="Статус заказа и время выдачи" />
  <bpmn:message id="Message_Receipt" name="Акт выдачи" />
  <bpmn:collaboration id="RepairConversation" name="Отдел ремонта техники — Диалог">
    <bpmn:participant id="Customer" name="Клиент" />
    <bpmn:participant id="Workshop" name="Отдел ремонта техники" />
    <bpmn:messageFlow id="MessageFlow_Request" name="Заявка на ремонт" sourceRef="Customer" targetRef="Workshop" messageRef="Message_Request" />
    <bpmn:messageFlow id="MessageFlow_Estimate" name="Диагноз, стоимость и срок" sourceRef="Workshop" targetRef="Customer" messageRef="Message_Estimate" />
    <bpmn:messageFlow id="MessageFlow_Decision" name="Согласие или отказ" sourceRef="Customer" targetRef="Workshop" messageRef="Message_Decision" />
    <bpmn:messageFlow id="MessageFlow_Ready" name="Статус заказа и время выдачи" sourceRef="Workshop" targetRef="Customer" messageRef="Message_Ready" />
    <bpmn:messageFlow id="MessageFlow_Receipt" name="Акт выдачи" sourceRef="Workshop" targetRef="Customer" messageRef="Message_Receipt" />
    <bpmn:conversation id="Intake" name="Приём заявки">
      <bpmn:participantRef>Customer</bpmn:participantRef>
      <bpmn:participantRef>Workshop</bpmn:participantRef>
      <bpmn:messageFlowRef>MessageFlow_Request</bpmn:messageFlowRef>
    </bpmn:conversation>
    <bpmn:conversation id="Approval" name="Согласование ремонта">
      <bpmn:participantRef>Customer</bpmn:participantRef>
      <bpmn:participantRef>Workshop</bpmn:participantRef>
      <bpmn:messageFlowRef>MessageFlow_Estimate</bpmn:messageFlowRef>
      <bpmn:messageFlowRef>MessageFlow_Decision</bpmn:messageFlowRef>
    </bpmn:conversation>
    <bpmn:conversation id="Return" name="Выдача техники">
      <bpmn:participantRef>Customer</bpmn:participantRef>
      <bpmn:participantRef>Workshop</bpmn:participantRef>
      <bpmn:messageFlowRef>MessageFlow_Ready</bpmn:messageFlowRef>
      <bpmn:messageFlowRef>MessageFlow_Receipt</bpmn:messageFlowRef>
    </bpmn:conversation>
    <bpmn:conversationLink id="Link_Customer_Intake" sourceRef="Customer" targetRef="Intake" />
    <bpmn:conversationLink id="Link_Workshop_Intake" sourceRef="Workshop" targetRef="Intake" />
    <bpmn:conversationLink id="Link_Customer_Approval" sourceRef="Customer" targetRef="Approval" />
    <bpmn:conversationLink id="Link_Workshop_Approval" sourceRef="Workshop" targetRef="Approval" />
    <bpmn:conversationLink id="Link_Customer_Return" sourceRef="Customer" targetRef="Return" />
    <bpmn:conversationLink id="Link_Workshop_Return" sourceRef="Workshop" targetRef="Return" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_RepairConversation" name="Отдел ремонта техники — Диалог">
    <bpmndi:BPMNPlane id="Plane_RepairConversation" bpmnElement="RepairConversation">
      <bpmndi:BPMNShape id="Shape_Customer" bpmnElement="Customer" isHorizontal="true">
        <dc:Bounds x="120" y="55" width="820" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Workshop" bpmnElement="Workshop" isHorizontal="true">
        <dc:Bounds x="120" y="337" width="820" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Intake" bpmnElement="Intake">
        <dc:Bounds x="169" y="181" width="152" height="92" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="173" y="209" width="144" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Approval" bpmnElement="Approval">
        <dc:Bounds x="454" y="181" width="152" height="92" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="458" y="209" width="144" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Return" bpmnElement="Return">
        <dc:Bounds x="739" y="181" width="152" height="92" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="743" y="209" width="144" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Link_Customer_Intake" bpmnElement="Link_Customer_Intake">
        <di:waypoint x="245" y="119" />
        <di:waypoint x="245" y="181" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Link_Workshop_Intake" bpmnElement="Link_Workshop_Intake">
        <di:waypoint x="245" y="337" />
        <di:waypoint x="245" y="273" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Link_Customer_Approval" bpmnElement="Link_Customer_Approval">
        <di:waypoint x="530" y="119" />
        <di:waypoint x="530" y="181" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Link_Workshop_Approval" bpmnElement="Link_Workshop_Approval">
        <di:waypoint x="530" y="337" />
        <di:waypoint x="530" y="273" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Link_Customer_Return" bpmnElement="Link_Customer_Return">
        <di:waypoint x="815" y="119" />
        <di:waypoint x="815" y="181" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Link_Workshop_Return" bpmnElement="Link_Workshop_Return">
        <di:waypoint x="815" y="337" />
        <di:waypoint x="815" y="273" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>