        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MessageFlow_Decision" bpmnElement="MessageFlow_Decision">
        <di:waypoint x="914" y="167" />
        <di:waypoint x="914" y="338" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="923" y="242" width="175" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_MessageFlow_Ready" bpmnElement="MessageFlow_Ready">
        <di:waypoint x="1630" y="338" />
        <di:waypoint x="1630" y="167" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1639" y="242" width="145" height="32" />
