<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RepairCollaboration" targetNamespace="urn:tech-repair:bpmn">
  <bpmn:message id="Message_Request" name="Заявка на ремонт" />
  <bpmn:message id="Message_Estimate" name="Диагноз, стоимость и срок" />
  <bpmn:message id="Message_Decision" name="Согласие или отказ" />
  <bpmn:message id="Message_Ready" name="Статус заказа и время выдачи" />
  <bpmn:message id="Message_Receipt" name="Акт выдачи" />
  <bpmn:collaboration id="RepairCollaboration" name="Отдел ремонта техники — Взаимодействие">
    <bpmn:participant id="Customer" name="Клиент" processRef="ClientProcess" />
    <bpmn:participant id="Workshop" name="Отдел ремонта техники" processRef="RepairProcess" />
    <bpmn:messageFlow id="MessageFlow_Request" name="Заявка на ремонт" sourceRef="C_Request" targetRef="R_Start" messageRef="Message_Request" />
    <bpmn:messageFlow id="MessageFlow_Estimate" name="Диагноз, стоимость и срок" sourceRef="R_Estimate" targetRef="C_Estimate" messageRef="Message_Estimate" />
    <bpmn:messageFlow id="MessageFlow_Decision" name="Согласие или отказ" sourceRef="C_Decision" targetRef="R_Decision" messageRef="Message_Decision" />
    <bpmn:messageFlow id="MessageFlow_Ready" name="Статус заказа и время выдачи" sourceRef="R_Ready" targetRef="C_Ready" messageRef="Message_Ready" />
    <bpmn:messageFlow id="MessageFlow_Receipt" name="Акт выдачи" sourceRef="R_Receipt" targetRef="C_Receipt" messageRef="Message_Receipt" />
  </bpmn:collaboration>
  <bpmn:process id="ClientProcess" name="Оформление ремонта клиентом" isExecutable="false">
    <bpmn:startEvent id="C_Start" name="Обнаружена неисправность">
      <bpmn:outgoing>C_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="C_Request" name="Подать заявку и передать технику" messageRef="Message_Request">
      <bpmn:incoming>C_1</bpmn:incoming>
      <bpmn:outgoing>C_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_Estimate" name="Получить смету" messageRef="Message_Estimate">
      <bpmn:incoming>C_2</bpmn:incoming>
      <bpmn:outgoing>C_3</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="C_Review" name="Рассмотреть смету">
      <bpmn:incoming>C_3</bpmn:incoming>
      <bpmn:outgoing>C_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="C_Decision" name="Сообщить решение" messageRef="Message_Decision">
      <bpmn:incoming>C_4</bpmn:incoming>
      <bpmn:outgoing>C_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_Ready" name="Получить уведомление о выдаче" messageRef="Message_Ready">
      <bpmn:incoming>C_5</bpmn:incoming>
      <bpmn:outgoing>C_6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="C_Receipt" name="Подписать акт и забрать технику">
      <bpmn:incoming>C_6</bpmn:incoming>
      <bpmn:outgoing>C_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="C_End" name="Техника получена">
      <bpmn:incoming>C_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="C_1" sourceRef="C_Start" targetRef="C_Request" />
    <bpmn:sequenceFlow id="C_2" sourceRef="C_Request" targetRef="C_Estimate" />
    <bpmn:sequenceFlow id="C_3" sourceRef="C_Estimate" targetRef="C_Review" />
    <bpmn:sequenceFlow id="C_4" sourceRef="C_Review" targetRef="C_Decision" />
    <bpmn:sequenceFlow id="C_5" sourceRef="C_Decision" targetRef="C_Ready" />
    <bpmn:sequenceFlow id="C_6" sourceRef="C_Ready" targetRef="C_Receipt" />
    <bpmn:sequenceFlow id="C_7" sourceRef="C_Receipt" targetRef="C_End" />
  </bpmn:process>
  <bpmn:process id="RepairProcess" name="Выполнение ремонта и выдача техники" isExecutable="false">
    <bpmn:startEvent id="R_Start" name="Заявка получена">
      <bpmn:outgoing>R_A_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="R_Start_Definition" messageRef="Message_Request" />
    </bpmn:startEvent>
    <bpmn:userTask id="R_Register" name="Зарегистрировать заказ">
      <bpmn:incoming>R_A_1</bpmn:incoming>
      <bpmn:outgoing>R_A_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="R_Diagnose" name="Провести диагностику">
      <bpmn:incoming>R_A_2</bpmn:incoming>
      <bpmn:outgoing>R_A_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="R_Estimate" name="Отправить смету" messageRef="Message_Estimate">
      <bpmn:incoming>R_A_3</bpmn:incoming>
      <bpmn:outgoing>R_A_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="R_Decision" name="Получить решение клиента" messageRef="Message_Decision">
      <bpmn:incoming>R_A_4</bpmn:incoming>
      <bpmn:outgoing>R_A_5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="R_Approved" name="Ремонт согласован?" gatewayDirection="Diverging">
      <bpmn:incoming>R_A_5</bpmn:incoming>
      <bpmn:outgoing>R_Yes</bpmn:outgoing>
      <bpmn:outgoing>R_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="R_Repair" name="Выполнить ремонт">
      <bpmn:incoming>R_Yes</bpmn:incoming>
      <bpmn:incoming>R_Retry</bpmn:incoming>
      <bpmn:outgoing>R_TestFlow</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="R_Test" name="Проверить исправность">
      <bpmn:incoming>R_TestFlow</bpmn:incoming>
      <bpmn:outgoing>R_DecideTest</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="R_Passed" name="Проверка пройдена?" gatewayDirection="Diverging">
      <bpmn:incoming>R_DecideTest</bpmn:incoming>
      <bpmn:outgoing>R_Retry</bpmn:outgoing>
      <bpmn:outgoing>R_Pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="R_Cancel" name="Оформить возврат без ремонта">
      <bpmn:incoming>R_No</bpmn:incoming>
      <bpmn:outgoing>R_AfterCancel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="R_Join" name="" gatewayDirection="Converging">
      <bpmn:incoming>R_Pass</bpmn:incoming>
      <bpmn:incoming>R_AfterCancel</bpmn:incoming>
      <bpmn:outgoing>R_B_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="R_Ready" name="Уведомить о выдаче" messageRef="Message_Ready">
      <bpmn:incoming>R_B_1</bpmn:incoming>
      <bpmn:outgoing>R_B_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="R_Receipt" name="Выдать технику и акт">
      <bpmn:incoming>R_B_2</bpmn:incoming>
      <bpmn:outgoing>R_B_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="R_End" name="Заказ закрыт">
      <bpmn:incoming>R_B_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="R_A_1" sourceRef="R_Start" targetRef="R_Register" />
    <bpmn:sequenceFlow id="R_A_2" sourceRef="R_Register" targetRef="R_Diagnose" />
    <bpmn:sequenceFlow id="R_A_3" sourceRef="R_Diagnose" targetRef="R_Estimate" />
    <bpmn:sequenceFlow id="R_A_4" sourceRef="R_Estimate" targetRef="R_Decision" />
    <bpmn:sequenceFlow id="R_A_5" sourceRef="R_Decision" targetRef="R_Approved" />
    <bpmn:sequenceFlow id="R_Yes" sourceRef="R_Approved" targetRef="R_Repair" name="Да" />
    <bpmn:sequenceFlow id="R_No" sourceRef="R_Approved" targetRef="R_Cancel" name="Нет" />
    <bpmn:sequenceFlow id="R_TestFlow" sourceRef="R_Repair" targetRef="R_Test" />
    <bpmn:sequenceFlow id="R_DecideTest" sourceRef="R_Test" targetRef="R_Passed" />
    <bpmn:sequenceFlow id="R_Retry" sourceRef="R_Passed" targetRef="R_Repair" name="Нет" />
    <bpmn:sequenceFlow id="R_Pass" sourceRef="R_Passed" targetRef="R_Join" name="Да" />
    <bpmn:sequenceFlow id="R_AfterCancel" sourceRef="R_Cancel" targetRef="R_Join" />
    <bpmn:sequenceFlow id="R_B_1" sourceRef="R_Join" targetRef="R_Ready" />
    <bpmn:sequenceFlow id="R_B_2" sourceRef="R_Ready" targetRef="R_Receipt" />
    <bpmn:sequenceFlow id="R_B_3" sourceRef="R_Receipt" targetRef="R_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_RepairCollaboration" name="Отдел ремонта техники — Взаимодействие">
    <bpmndi:BPMNPlane id="Plane_RepairCollaboration" bpmnElement="RepairCollaboration">
